# Example environment variables for local development.
# Django does not load this file automatically. Supply variables through
# your shell, process manager, or deployment environment.
# Copy to a local `.env` only if your tooling loads it externally.
# `.env` is not committed.

# Django core
DJANGO_SECRET_KEY=insecure-example-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=tezcan_envanter
POSTGRES_USER=tezcan_envanter
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
